# WasiAI agent key (x-agent-key) — get from https://app.wasiai.io/settings/api-keys
WASIAI_API_KEY=your_wasiai_agent_key_here

# WasiAI agent slug to call (e.g. wasi-defi-sentiment)
WASIAI_AGENT_SLUG=wasi-defi-sentiment

# WasiAI base URL (optional, defaults to https://app.wasiai.io)
WASIAI_BASE_URL=https://app.wasiai.io

# Coinbase CDP API credentials — get from https://portal.cdp.coinbase.com/
# Note: AgentKit 0.10.x uses cdpApiKeyId / cdpApiKeySecret (not Name/PrivateKey)
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret

# OpenAI API key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

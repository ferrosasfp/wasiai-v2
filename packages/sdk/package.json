{
  "name": "@wasiai/sdk",
  "version": "0.1.0",
  "description": "SDK para publicar y monetizar agentes IA en WasiAI marketplace",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./nextjs": {
      "types": "./dist/handlers/nextjs.d.ts",
      "import": "./dist/handlers/nextjs.mjs",
      "require": "./dist/handlers/nextjs.js"
    },
    "./express": {
      "types": "./dist/handlers/express.d.ts",
      "import": "./dist/handlers/express.mjs",
      "require": "./dist/handlers/express.js"
    }
  },
  "bin": {
    "wasiai": "./bin/wasiai.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/handlers/nextjs.ts src/handlers/express.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["wasiai", "ai", "agents", "x402", "avalanche", "marketplace"],
  "license": "MIT",
  "dependencies": {
    "uvd-x402-sdk": "^2.25.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
